# Porta em que a API Express será servida.
PORT=3001

# String de conexão do PostgreSQL (obtida no provedor do banco, ex.: Render, Supabase, Railway).
DATABASE_URL=postgresql://usuario:senha@localhost:5432/raiz_silvestre

# Segredo usado para assinar os tokens JWT. Gere um valor forte e único em produção.
JWT_SECRET=troque-este-valor-por-um-segredo-forte

# Token das rotas administrativas (criar/editar/apagar cuidados, enviar/apagar fotos).
# Enviado no header X-Admin-Token. Se ficar vazio, essas rotas permanecem bloqueadas (403).
ADMIN_TOKEN=

# Origem permitida pelo CORS (URL do front-end publicado). Use "*" apenas em desenvolvimento.
# Aceita várias origens separadas por vírgula, ex.: https://raizsilvestre.com.br,http://localhost:5500
CORS_ORIGIN=http://localhost:5500

# Segredo usado para gerar o hash do IP nas avaliações (anti-reenvio). Se vazio, usa JWT_SECRET.
AVALIACOES_HASH_SECRET=

# Número de proxies à frente da API. No Render use 1 para que o limite de envios por IP funcione.
TRUST_PROXY=

# Ambiente de execução: development | production. Ativa logs detalhados quando "production".
NODE_ENV=development
